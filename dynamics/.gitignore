/.lake

# Blueprint build artifacts (regenerated by `leanblueprint pdf`/`web` and by CI)
/blueprint/web/
/blueprint/print/
/blueprint/lean_decls
/blueprint/src/*.paux

# Local-only scratch files (not part of the committed doc build)
/docbuild/

# latexmk build byproducts of a LaTeX proof in latex/ (its PDF IS committed)
/latex/*.aux
/latex/*.fdb_latexmk
/latex/*.fls
/latex/*.log
/latex/*.out
/latex/*.synctex.gz
